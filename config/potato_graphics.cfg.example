# ================================================================================
#  No Rest for the Potato — Graphics Settings (NRTPMod v0.3.5)
# ================================================================================
#  Этот файл читается модом NRTPMod.dll при запуске игры.
#  Изменяйте значения ниже, сохраняйте файл и запускайте игру — настройки
#  применятся автоматически.
#
#  Формат: Параметр=Значение
#  true/false  — включить/выключить
#  Числа       — см. описание под каждым параметром
#  Строки, начинающиеся с # — комментарии, их игнорирует мод
# ================================================================================

# ------------------------------------------------------------------------------
# 1. ТЕНИ (Shadows) — максимальное влияние на FPS
# ------------------------------------------------------------------------------

# Включить/выключить тени полностью.
#   true  = тени включены
#   false = тени отключены (максимальный прирост FPS)
ShadowsEnabled=false

# Дистанция отрисовки теней (в метрах).
#   0   = без теней
#   20  = очень мало (рекомендуется для слабых ПК)
#   50  = средне
#   100+ = далеко (тяжело для GPU)
ShadowDistance=20

# Количество каскадов теней (уровней детализации по дистанции).
#   0 = минимум (максимальный FPS)
#   1 = мало
#   2 = средне
#   3 = много
#   4 = максимум (качество, тяжко для CPU/GPU)
ShadowCascades=0

# Разрешение карт теней.
#   0 = Low
#   1 = Medium
#   2 = High
#   3 = Very High
ShadowResolution=0

# ------------------------------------------------------------------------------
# 2. ТЕКСТУРЫ (Textures)
# ------------------------------------------------------------------------------

# Качество текстур.
#   0 = Полное (Full)      — максимальное качество, много видеопамяти
#   1 = Половина (Half)    — сбалансировано (рекомендуется для Ultra Low)
#   2 = Четверть (Quarter) — минимум видеопамяти (может вызывать вылеты на слабом ПК)
TextureQuality=1

# Анизотропная фильтрация текстур.
#   true  = включено (лучше качество, чуть ниже FPS)
#   false = выключено (быстрее)
Anisotropic=false

# ------------------------------------------------------------------------------
# 3. СГЛАЖИВАНИЕ (Anti-Aliasing)
# ------------------------------------------------------------------------------

# Уровень сглаживания (MSAA/SMAA).
#   0 = выключено (максимальный FPS)
#   2 = 2x
#   4 = 4x
#   8 = 8x (максимальное качество, сильно снижает FPS)
AntiAliasing=0

# ------------------------------------------------------------------------------
# 4. ЭФФЕКТЫ (Effects)
# ------------------------------------------------------------------------------

# Размытие движения (Motion Blur).
#   true  = включено
#   false = выключено (рекомендуется выключить для FPS и ясности картинки)
MotionBlur=false

# Туман (Fog).
#   true  = включено
#   false = выключено
FogEnabled=false

# Блум / свечение ярких объектов (Bloom).
#   true  = включено
#   false = выключено
BloomEnabled=false

# Глубина резкости (Depth of Field — размытие заднего плана).
#   true  = включено
#   false = выключено
DepthOfFieldEnabled=false

# Отражения (Reflections).
#   true  = включено
#   false = выключено
ReflectionsEnabled=false

# Постобработка (Post-Processing — цветокоррекция, эффекты камеры).
#   true  = включено
#   false = выключено
PostProcessingEnabled=false

# ------------------------------------------------------------------------------
# 5. ОСВЕЩЕНИЕ (Lighting)
# ------------------------------------------------------------------------------

# HDR (High Dynamic Range).
#   true  = включено
#   false = выключено (быстрее, меньше нагрузка на GPU)
HdrEnabled=false

# Объемное освещение (Volumetric Lighting — лучи солнца, световые объемы).
#   true  = включено (очень тяжело для GPU)
#   false = выключено
VolumetricLightingEnabled=false

# Тени от облаков (Cloud Shadows).
#   true  = включено
#   false = выключено
CloudShadowsEnabled=false

# Ambient Occlusion (затенение в углах, щелках и стыках объектов).
#   true  = включено
#   false = выключено (быстрее)
AmbientOcclusionEnabled=false

# ------------------------------------------------------------------------------
# 6. ДОПОЛНИТЕЛЬНАЯ ОПТИМИЗАЦИЯ (v0.3.5)
# ------------------------------------------------------------------------------

# Occlusion Culling — скрывает объекты, за которые не видно (за стенами и т.д.).
#   true  = включено (Unity сам решает, что не рисовать, но грузит CPU)
#   false = выключено (быстрее на слабых CPU, но может рендерить лишнее)
OcclusionCullingEnabled=false

# Forward Rendering вместо Deferred.
#   true  = включить Forward (лучше для слабых GPU, если мало пиксельных светов)
#   false = оставить Deferred (качество по умолчанию)
ForwardRenderingEnabled=false

# Лимит пиксельных источников света (Pixel Lights).
#   1 = минимум (рекомендуется для слабого железа)
#   2+  = больше светов, больше draw calls, ниже FPS
PixelLightCount=1

# Целевой FPS (ограничение кадров в секунду).
#   0   = без лимита
#   30  = 30 FPS (экономия GPU/CPU)
#   60  = 60 FPS
#   144 = 144 FPS
TargetFrameRate=60

# Потоковые текстуры (Mipmap Streaming).
#   true  = включено (текстуры грузятся по мере необходимости, экономит VRAM)
#   false = выключено (все текстуры сразу в памяти)
StreamingMipmapsEnabled=false

# Бюджет потоковых текстур (в мегабайтах).
#   256  = мало памяти под текстуры
#   512  = средне
#   1024 = много (для мощных видеокарт)
StreamingMipmapsBudget=512

# Максимальное снижение уровня мипмап для потоковых текстур.
#   0 = без снижения (полное качество)
#   1 = слабое снижение
#   2 = среднее снижение
#   3+  = сильное снижение (быстрее, но текстуры размытее)
StreamingMipmapsMaxReduction=2

# Время асинхронной загрузки текстур за кадр (в мс).
#   1  = очень мало (меньше фризов, но текстуры грузятся медленно)
#   2  = средне
#   4+ = больше (текстуры грузятся быстрее, но могут быть микро-фризы)
AsyncUploadTimeSlice=2

# Смещение уровня детализации (LOD Bias).
#   0.5  = объекты детальнее на расстоянии (больше нагрузка)
#   1.0  = стандарт
#   1.5+ = объекты грубее на расстоянии (меньше нагрузка, быстрее)
LodBias=1.0

# ------------------------------------------------------------------------------
# 7. ЧАСТИЦЫ (Particles)
# ------------------------------------------------------------------------------

# Включить/выключить частицы полностью (дым, огонь, искры, магические эффекты).
#   true  = включены
#   false = выключены (максимальный FPS, но может ломать геймплей)
ParticlesEnabled=true

# Множитель количества частиц (если ParticlesEnabled=true).
#   0.1 = 10% от исходного (очень мало частиц)
#   0.3 = 30% (рекомендуется для Ultra Low — сохраняет геймплей, снижает нагрузку)
#   0.5 = 50%
#   1.0 = 100% (как в игре по умолчанию)
ParticleMultiplier=0.3

# ------------------------------------------------------------------------------
# 8. ДИАГНОСТИКА (v0.3.5)
# ------------------------------------------------------------------------------

# Логирование использования памяти.
#   true  = включено (пишет в консоль MelonLoader объём памяти)
#   false = выключено
LogMemoryEnabled=false

# ------------------------------------------------------------------------------
# 9. МОД (Mod)
# ------------------------------------------------------------------------------

# Включен ли мод NRTPMod.dll (заполняется лаунчером автоматически).
#   true  = мод активен
#   false = мод выключен
ModEnabled=true

# ------------------------------------------------------------------------------
# 10. ПРЕДУСТАНОВКИ (Presets) — готовые наборы для лаунчера
# ------------------------------------------------------------------------------
#
# Ultra Low: Тени выключены, текстуры Half, сглаживание выключено,
#            все тяжелые эффекты выключены, RenderScale=0.6 (не 0.3!),
#            ParticlesEnabled=true (multiplier=0.3), TargetFrameRate=60,
#            StreamingMipmapsEnabled=false, LodBias=1.2
#
# Low: Тени выключены, текстуры четверть, сглаживание выключено,
#      все тяжелые эффекты выключены. RenderScale=0.75
#
# Medium: Тени включены (дистанция 40, каскады 1), текстуры половина,
#         сглаживание 2, 일부 эффекты включены.
#
# High: Всё включено, полное качество. RenderScale=1.0
#
# Default: Стандартные настройки игры. Мод выключен.
# ================================================================================
